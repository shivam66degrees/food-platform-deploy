# Optional overrides for food-platform-deploy scripts (copy to env.local and source)

# Path to food-delivery-platform workspace (auto-detected when deploy repo sits inside it)
# PLATFORM_ROOT=/path/to/food-delivery-platform

IMAGE_REGISTRY=food
IMAGE_TAG=local

HELM_RELEASE=food-platform
HELM_NAMESPACE=food-platform
HELM_TIMEOUT=15m
